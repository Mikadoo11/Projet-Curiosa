# Public site URL (used in metadata, sitemap and robots.txt)
SITE_URL=http://localhost:3000

# Sanity CMS — leave empty to use the local demo content
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# IA pipeline — configured in a later phase; keep secrets server-side
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Background tasks — configured when the generation pipeline is implemented
TRIGGER_SECRET_KEY=
CRON_SECRET=
