# URL publique du site (à remplacer après le déploiement Vercel)
SITE_URL=http://localhost:3000

# Sanity CMS — le Project ID est public, le token d'écriture doit rester secret
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Google Gemini API — utiliser le niveau gratuit et ne pas activer la facturation pour ce projet
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Sécurité : laisser la génération désactivée jusqu'à la fin de la configuration
GENERATION_ENABLED=false
GENERATION_DAILY_TARGET=5
CRON_SECRET=
